{
  // Typecheck propio del paquete, con `strict` completo. apps/api compila con
  // `strict` parcial (strictNullChecks sí, noImplicitAny no) y apps/game con
  // strict entero: verificar acá contra el más severo de los dos garantiza
  // que el paquete entra limpio en ambos.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "typeRoots": ["../../apps/api/node_modules/@types"]
  },
  "include": ["**/*.ts"]
}
