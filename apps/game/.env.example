# Base URL de apps/api (REST + Socket.IO + SSE). Obligatoria en producción
# (build falla en runtime si falta); en desarrollo cae a http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# A dónde volver cuando no hay sesión activa (redirectToWebLogin). Opcional,
# cae a http://localhost:3000 en desarrollo.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Opcional. Link de invitación a Discord mostrado en el sidebar. Sin esta
# variable usa un default hardcodeado.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/codebuddies
