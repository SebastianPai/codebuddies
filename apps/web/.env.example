# Base URL for the CodeBuddies API, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. Defaults to NEXT_PUBLIC_API_URL when not supplied.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Public URL of apps/game, used by the login page to recognize a
# ?redirect= target as "the game" and hand off the JWT to it. Optional,
# defaults to http://localhost:3002 (apps/game's local dev port).
NEXT_PUBLIC_GAME_URL=http://localhost:3002
