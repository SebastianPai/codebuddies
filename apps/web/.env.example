# Base URL for the CodeBuddies API, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. Defaults to NEXT_PUBLIC_API_URL when not supplied.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Public URL of apps/game, used by the login page to recognize a
# ?redirect= target as "the game" and hand off the JWT to it. Optional,
# defaults to http://localhost:3002 (apps/game's local dev port).
NEXT_PUBLIC_GAME_URL=http://localhost:3002

# Public base URL for static assets served from Cloudflare R2 (e.g.
# https://assets.codebuddies.tech, or the bucket's r2.dev subdomain until a
# custom domain is set up). No trailing slash. Baked into the bundle at
# build time (NEXT_PUBLIC_*). Optional — falls back to an empty string if
# unset (getAssetsUrl() in src/config/env.ts).
NEXT_PUBLIC_ASSETS_URL=

# Paddle (checkout client-side en /pricing, ver src/config/paddle-catalog.ts).
# Paddle.js corre en el navegador, así que TODO acá debe ser NEXT_PUBLIC_* --
# nunca la PADDLE_API_KEY secreta, que solo vive en apps/api. Sin estas
# variables, /pricing falla explícitamente al cargar en vez de asumir un
# entorno/catálogo por default.
#
# Client-side token (test_... en sandbox, live_... en producción) — Paddle
# Dashboard > Developer Tools > Authentication > Client-side tokens.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" o "production" — debe coincidir con el entorno del token de
# arriba y con PADDLE_ENVIRONMENT en apps/api.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Price ids de CodeBuddies Pro (mensual/anual).
NEXT_PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_YEARLY_PRICE_ID=
# Price id del certificado oficial (solo para mostrar el precio localizado
# en /pricing — la compra real sigue el flujo por curso en /certificates).
NEXT_PUBLIC_PADDLE_CERTIFICATE_PRICE_ID=
# Price ids de cada paquete de monedas.
NEXT_PUBLIC_PADDLE_COIN_PRICE_ID_500=
NEXT_PUBLIC_PADDLE_COIN_PRICE_ID_1100=
NEXT_PUBLIC_PADDLE_COIN_PRICE_ID_3400=
NEXT_PUBLIC_PADDLE_COIN_PRICE_ID_6000=
