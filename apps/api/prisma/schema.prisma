model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  password        String
  role            Role      @default(STUDENT)
  // Cuenta controlada por el motor, no por una persona (competidores reales
  // de CodeStudio en fases futuras del rediseño — ver plan de migración).
  // Boolean aditivo en vez de un tercer valor de Role: nada del código
  // actual que filtra por role asume que existan cuentas de sistema, asi que
  // un enum nuevo hubiera sido mas arriesgado de auditar que un flag aparte.
  isSystemAccount Boolean   @default(false)
  emailVerified   Boolean   @default(true)
  avatarUrl       String?
  avatarBorder    String?
  location        String?
  institution     String?
  birthDate       DateTime?
  country         String?

  experience Int @default(0)
  coins      Int @default(0)
  level      Int @default(1)

  energy                 Int       @default(5)
  streak                 Int       @default(0)
  bestStreak             Int       @default(0)
  lastLoginAt            DateTime?
  lastLearningActivityAt DateTime?
  marketingEmailsEnabled Boolean   @default(true)
  marketingEmailOptedAt  DateTime  @default(now())

  energyUpdatedAt DateTime @default(now())
  adsWatchedToday Int      @default(0)
  adsResetAt      DateTime @default(now())

  preferredLanguageId String?

  // Idioma de la interfaz (es/en-us/zh-Hans) — separado a propósito de
  // preferredLanguage/Language (ese modelo es para el idioma del CONTENIDO
  // de cursos/items, con sus propios códigos "en" sin "-us" y soporte RTL;
  // mezclarlo con el idioma de la UI de apps/web y apps/game hubiera
  // acoplado dos cosas con semántica distinta). Compartido entre apps/web y
  // apps/game: cualquiera de las dos lee/escribe este mismo campo.
  uiLanguage String @default("es")

  // Tema claro/oscuro del simulador de PC — antes vivia solo en
  // localStorage ("propio de esta ventana"), por eso no se veia igual en
  // otro navegador/dispositivo. Mismo criterio que uiLanguage: la cuenta
  // manda, localStorage es solo cache para pintar rapido.
  pcTheme String @default("dark")

  // Color/tema de la burbuja de chat flotante sobre el personaje (ver
  // CHAT_BUBBLE_THEMES en apps/game). null = "classic" (default gratis).
  // Algunos ids son Premium — se valida en IdentityService#updateProfile,
  // no acá (Prisma no valida contra una suscripcion activa).
  chatBubbleThemeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments      Enrollment[]
  completions      Completion[]
  exerciseAttempts ExerciseAttempt[]

  userPowers               UserPower[]
  rankings                 Ranking[]
  rankingSeasonEntries     RankingSeasonEntry[]
  courseReviews            CourseReview[]
  courseProjectSubmissions CourseProjectSubmission[]
  contentComments          ContentComment[]
  contentReports           ContentReport[]

  premiumSubscriptions PremiumSubscription[]
  certificates         Certificate[]
  certificateOrders    CertificateOrder[]
  certificateAccesses  CertificateAccess[]

  preferredLanguage Language? @relation(fields: [preferredLanguageId], references: [id])

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  posts    Post[]
  projects Project[]

  activities Activity[]

  coinTransactions CoinTransaction[]
  xpTransactions   XPTransaction[]

  // Relaciones bidireccionales añadidas
  postComments           PostComment[]
  postLikes              PostLike[]
  projectLikes           ProjectLike[]
  challengesAsChallenger FriendChallenge[] @relation("ChallengeChallenger")
  challengesAsOpponent   FriendChallenge[] @relation("ChallengeOpponent")
  challengesWon          FriendChallenge[] @relation("ChallengeWinner")

  duelsAsPlayer1 Duel[] @relation("DuelPlayer1")
  duelsAsPlayer2 Duel[] @relation("DuelPlayer2")

  // juego
  avatar Avatar?
  items  UserItem[]
  rooms  Room[]
  apps   App[]

  roomUsers           RoomUser[]
  roomPermissions     RoomPermission[]
  roomRequests        RoomJoinRequest[]
  roomInvitesSent     RoomInvite[]         @relation("SentInvites")
  roomInvitesReceived RoomInvite[]         @relation("ReceivedInvites")
  roomRatings         RoomRating[]
  roomItems           RoomItem[]
  backgrounds         UserRoomBackground[]

  friendshipsInitiated     Friendship[]                  @relation("FriendshipRequester")
  friendshipsReceived      Friendship[]                  @relation("FriendshipAddressee")
  sentMessageRequests      MessageRequest[]              @relation("MessageRequestSender")
  receivedMessageRequests  MessageRequest[]              @relation("MessageRequestReceiver")
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  notifications            Notification[]
  emailLogs                EmailLog[]
  emailAuditLogs           EmailAuditLog[]
  referralProfile          ReferralProfile?
  referralsSent            Referral[]                    @relation("ReferralReferrer")
  referralSource           Referral?                     @relation("ReferralReferred")
  referralRewardGrants     ReferralRewardGrant[]
  referralSeasons          ReferralSeasonStat[]
  referralFraudLogs        ReferralFraudLog[]
  missionProgress          UserMissionProgress[]
  gamificationAchievements UserGamificationAchievement[]
  gamificationBadges       UserGamificationBadge[]
  gamificationTitles       UserGamificationTitle[]
  rewardLedger             RewardLedgerEntry[]
  rewardBundles            RewardBundle[]
  creatorProfile           CreatorProfile?
  creatorApplications      CreatorApplication[]
  marketplaceFavorites     MarketplaceFavorite[]
  roomBuildFavorites       RoomBuildFavorite[]
  marketplacePurchases     MarketplacePurchase[]         @relation("MarketplaceBuyer")
  marketplaceRatings       MarketplaceRating[]
  marketplaceReports       MarketplaceReport[]
  marketplaceReviews       MarketplaceReviewComment[]    @relation("MarketplaceReviewAdmin")
  marketplaceWalletMoves   CreatorWalletMovement[]
  codeStudioCompanies      CodeStudioCompany[]
}

model App {
  id      String @id @default(uuid())
  ownerId String

  type   AppType
  status AppStatus @default(DRAFT)

  // lógica del jugador (bloques)
  logic Json

  logo       String?
  colorTheme String?

  // Nuevas métricas más ricas
  rating        Float @default(0)
  activeUsers   Int   @default(0)
  successRate   Float @default(0)
  totalRequests Int   @default(0)
  revenue       Float @default(0) // nuevo
  retention     Float @default(0) // nuevo
  churnRate     Float @default(0) // nuevo
  avgRating     Float @default(0) // nuevo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  translations AppTranslation[]

  metrics AppMetrics?

  snapshots AppSimulationSnapshot[]

  @@index([ownerId])
}

model AppTranslation {
  id         String @id @default(uuid())
  appId      String
  languageId String

  name        String
  description String?

  app      App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([appId, languageId])
}

model AppMetrics {
  id    String @id @default(uuid())
  appId String

  activeUsers   Int @default(0)
  successOrders Int @default(0)
  failedOrders  Int @default(0)

  lastTickAt DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId])
}

model AppSimulationSnapshot {
  id String @id @default(uuid())

  appId String

  users       Int
  successRate Float

  revenue   Float // nuevo
  retention Float // nuevo

  createdAt DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model Avatar {
  id     String @id @default(uuid())
  userId String @unique

  skinColor Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  slots AvatarSlot[]
}

model Item {
  id String @id @default(uuid())

  imageUrl String?

  layer  Int @default(0)
  rarity Int @default(0)

  colorable Boolean @default(false)

  // economy
  coinsPrice Int?
  gemsPrice  Int?

  isTradable Boolean @default(true)
  isSellable Boolean @default(true)

  shopVisible Boolean @default(true)

  category String?

  type ItemType?

  maxStack Int @default(1)

  accessType ItemAccessType @default(FREE)

  createdAt DateTime @default(now())

  tags String[] @default([])

  popularity Int @default(0)
  views      Int @default(0)

  sprites ItemSprite[]

  avatarData AvatarItemData?
  worldData  WorldItemData?

  users                UserItem[]
  translations         ItemTranslation[]
  referralRewards      ReferralReward[]
  referralRewardGrants ReferralRewardGrant[]
  rewardLedgerEntries  RewardLedgerEntry[]
  marketplaceContents  MarketplaceContent[]  @relation("PublishedMarketplaceItem")

  avatarSlots    AvatarSlot[]
  roomItems      RoomItem[]
  buildFavorites RoomBuildFavorite[]
}

model AvatarItemData {
  id     String @id @default(uuid())
  itemId String @unique

  slot AvatarSlotType @default(BODY)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WorldItemData {
  id String @id @default(uuid())

  itemId String @unique

  width  Int
  height Int

  spriteSheetUrl String?

  previewImageUrl String?

  frameWidth  Int?
  frameHeight Int?

  footprintWidth  Int @default(1)
  footprintHeight Int @default(1)

  syncDirections Boolean @default(true)
  footprints     Json?
  surfaces       Json?
  engineData     Json?

  directions Int @default(4)

  kind WorldItemKind

  category FurnitureCategory @default(DECORATION)

  isCollidable Boolean @default(false)

  walkable Boolean @default(false)

  isInteractable Boolean @default(false)

  rotatable Boolean @default(true)

  placementType PlacementType @default(FLOOR)

  // stacking

  allowsStacking Boolean @default(false)

  canBeStacked Boolean @default(false)

  stackHeight Int @default(1)

  maxStackHeight Int @default(0)

  // interacciones

  interactionTypes InteractionType[]

  // posición para sentarse/acostarse

  sitX Int?
  sitY Int?

  sitElevation Int?

  // teleports

  teleportTargetRoomId String?

  teleportTargetX Int?
  teleportTargetY Int?

  // Base para "muebles que emiten luz" (ver plan de iluminación ambiental) —
  // sin ningún renderer todavía la lee, puro groundwork aditivo para no
  // tener que volver a tocar el esquema cuando se implemente.
  emitsLight  Boolean @default(false)
  lightRadius Int?
  lightColor  String?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ItemTranslation {
  id         String @id @default(uuid())
  itemId     String
  languageId String

  name        String
  description String?

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([itemId, languageId])
}

model UserItem {
  id String @id @default(uuid())

  userId String
  itemId String

  amount Int @default(1)

  equipped Boolean @default(false)

  // 🔥 NUEVO
  obtainedAt DateTime @default(now())

  // 🔥 por si luego haces regalos/trades/eventos
  source String? // shop, reward, admin, event, trade

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model AvatarSlot {
  id String @id @default(uuid())

  avatarId String
  slot     AvatarSlotType

  itemId String?

  color Int?

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  item   Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([avatarId, slot])
}

model ItemSprite {
  id     String @id @default(uuid())
  itemId String

  animationId String
  animation   Animation @relation(fields: [animationId], references: [id])

  direction Direction

  imageUrl String

  frameWidth  Int
  frameHeight Int
  framesCount Int
  row         Int @default(0)

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, animationId, direction])
}

model Animation {
  id String @id @default(uuid())

  name    String // "Walk Ninja", "Dance HipHop"
  type    AnimationType
  variant String // 🔥 conecta con ItemSprite.variant

  loop  Boolean @default(true)
  speed Int     @default(100)

  createdAt DateTime @default(now())

  sprites ItemSprite[]

  @@unique([type, variant])
}

model Room {
  id      String @id @default(uuid())
  ownerId String

  name        String
  description String?
  // Categoría/etiquetas libres para la pestaña "General" de Editar Mundo —
  // sin uso todavía en filtros de búsqueda, solo metadata descriptiva.
  category    String?
  tags        String[] @default([])

  isPublic  Boolean @default(true)
  isVipOnly Boolean @default(false)

  // Reemplaza gradualmente a isPublic para el control de acceso: PUBLIC se
  // mantiene en sync con isPublic=true (getPublicRooms sigue filtrando por
  // isPublic sin cambios); PRIVATE_REQUEST es el comportamiento que YA tenían
  // todas las salas privadas (aceptar solicitudes de acceso); PRIVATE_INVITE_ONLY
  // es nuevo (ni siquiera se puede pedir acceso, solo entra quien ya tiene
  // permiso o invitación aprobada). Ver la migración para el backfill.
  accessMode RoomAccessMode @default(PUBLIC)

  maxUsers Int @default(20)

  width  Int @default(20)
  height Int @default(20)

  thumbnailUrl String?

  backgroundId String?
  layoutId     String?

  rating     Float @default(0)
  totalVotes Int   @default(0)

  // Iluminación ambiental (Premium) — null/0 = apagada, sin cambio visual
  // para ninguna sala existente hasta que su dueño la prenda explícitamente.
  ambientLightIntensity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items        RoomItem[]
  users        RoomUser[]
  permissions  RoomPermission[]
  joinRequests RoomJoinRequest[]
  invites      RoomInvite[]
  customRoles  RoomCustomRole[]

  ratings RoomRating[]

  background RoomBackground? @relation(fields: [backgroundId], references: [id])
  layout     RoomLayout?     @relation(fields: [layoutId], references: [id])

  @@index([ownerId])
  @@index([isPublic])
}

model RoomLayout {
  id String @id @default(uuid())

  name        String
  description String?

  previewImageUrl String? // 👈 miniatura para UI

  layoutJson Json // 👈 EL MAPA REAL

  width    Int
  height   Int
  tileSize Int

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())

  rooms Room[]
}

model RoomItem {
  id String @id @default(uuid())

  roomId String
  itemId String
  userId String

  // posición base

  x Int
  y Int

  // altura real

  elevation Int @default(0)

  // rotación

  rotation Int @default(0)

  // capa visual

  zIndex Int @default(0)

  // estado dinámico

  state Json?

  // stacking real

  parentRoomItemId String?

  parent RoomItem? @relation("RoomItemStack", fields: [parentRoomItemId], references: [id], onDelete: SetNull)

  children RoomItem[] @relation("RoomItemStack")

  // objetos de pared

  wallSide WallSide?

  wallOffset Int?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([itemId])
  @@index([roomId, x, y])
  @@index([parentRoomItemId])
}

model RoomJoinRequest {
  id     String @id @default(uuid())
  roomId String
  userId String

  status JoinRequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model RoomUser {
  id     String @id @default(uuid())
  roomId String
  userId String

  x         Int       @default(0)
  y         Int       @default(0)
  direction Direction @default(SOUTH)

  role RoomRole @default(VISITOR)

  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model RoomInvite {
  id         String @id @default(uuid())
  roomId     String
  fromUserId String
  toUserId   String

  createdAt DateTime          @default(now())
  status    JoinRequestStatus @default(PENDING)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Antes sin onDelete explícito, Prisma generó RESTRICT: borrar una cuenta
  // con invitaciones pendientes (enviadas o recibidas) fallaba con un error
  // de constraint de clave foránea sin manejar. Una invitación no tiene
  // sentido sin el remitente o el destinatario, así que Cascade es correcto
  // acá (igual que el resto de relaciones de Room hacia User en este schema).
  fromUser User @relation("SentInvites", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedInvites", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([roomId, toUserId])
}

model RoomPermission {
  id String @id @default(uuid())

  roomId String
  userId String

  role RoomRole

  // Si se asigna, sus 11 flags reemplazan al mapeo fijo de `role` para este
  // usuario (ver resolveEffectivePermissions en room-permissions.util.ts).
  // Nullable a propósito: una fila sin customRoleId sigue comportándose
  // exactamente como antes de que existiera este sistema.
  customRoleId String?

  createdAt DateTime @default(now())

  room       Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole RoomCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([customRoleId])
}

// Plantilla de permisos reutilizable por sala ("Decorador", "Moderador"...):
// se crea una vez y se asigna a varios invitados vía RoomPermission.customRoleId;
// editarla actualiza a todos los que la tienen, porque el resolver la lee en
// el momento de cada acción, no la copia al asignarla.
model RoomCustomRole {
  id     String @id @default(uuid())
  roomId String
  name   String

  colorHex String?

  canPlaceObjects      Boolean @default(false)
  canMoveObjects       Boolean @default(false)
  canRotateObjects     Boolean @default(false)
  canDeleteObjects     Boolean @default(false)
  canEditConfig        Boolean @default(false)
  canChangeFloor       Boolean @default(false)
  canChangeWalls       Boolean @default(false)
  canChangeBackground  Boolean @default(false)
  canManageGuests      Boolean @default(false)
  canManagePermissions Boolean @default(false)
  canModifyLighting    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignments RoomPermission[]

  @@unique([roomId, name])
}

model RoomBackground {
  id String @id @default(uuid())

  name        String
  description String?
  imageUrl    String
  previewUrl  String?
  categoryId  String?

  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  accessType  BackgroundAccessType @default(FREE)
  isPremium   Boolean              @default(false)
  isVip       Boolean              @default(false)
  shopVisible Boolean              @default(true)
  coinsPrice  Int                  @default(0)
  gemsPrice   Int                  @default(0)
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms        Room[]
  category     RoomBackgroundCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations RoomBackgroundTranslation[]
  owners       UserRoomBackground[]

  @@index([active, accessType])
  @@index([categoryId])
  @@index([sortOrder])
}

model RoomBackgroundCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backgrounds RoomBackground[]
}

model RoomBackgroundTranslation {
  id           String  @id @default(uuid())
  backgroundId String
  languageId   String
  name         String
  description  String?

  background RoomBackground @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([backgroundId, languageId])
  @@index([languageId])
}

model UserRoomBackground {
  id           String   @id @default(uuid())
  userId       String
  backgroundId String
  obtainedAt   DateTime @default(now())
  source       String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  background RoomBackground @relation(fields: [backgroundId], references: [id], onDelete: Cascade)

  @@unique([userId, backgroundId])
  @@index([userId])
  @@index([backgroundId])
}

model RoomRating {
  id     String @id @default(uuid())
  roomId String
  userId String

  value Int // 1 a 5

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Duel {
  id        String @id @default(uuid())
  player1Id String
  player2Id String

  exerciseId String

  winnerId String?

  createdAt DateTime @default(now())

  player1 User @relation("DuelPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 User @relation("DuelPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType @default(DIRECT)
  directKey String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  deliveredAt    DateTime?
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, seenAt])
  @@index([senderId])
}

model MessageRequest {
  id         String               @id @default(uuid())
  senderId   String
  receiverId String
  status     MessageRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  sender   User @relation("MessageRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Module {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  translations ModuleTranslation[]
  courses      Course[]
}

model ModuleTranslation {
  id          String  @id @default(uuid())
  moduleId    String
  languageId  String
  title       String
  description String?

  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([moduleId, languageId])
}

model Course {
  id         String        @id @default(uuid())
  moduleId   String?
  imageUrl   String?
  difficulty Difficulty    @default(EASY)
  freeLimit  Int           @default(5)
  // PUBLISHED por defecto: el contenido existente antes de este campo no
  // debe desaparecer del catálogo público al aplicar la migración.
  status     ContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now())

  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  lessons             Lesson[]
  enrollments         Enrollment[]
  completions         Completion[]
  certificates        Certificate[]
  certificateOrders   CertificateOrder[]
  certificateAccesses CertificateAccess[]

  translations CourseTranslation[]

  // Relación bidireccional añadida
  friendChallenges       FriendChallenge[]
  referralProgramConfigs ReferralProgramConfig[]

  learningPathCourses LearningPathCourse[]
  categories          CourseCategory[]     @relation("CourseToCourseCategory")

  // Self-relation many-to-many (NF2): "prerequisites" son los cursos que
  // ESTE curso requiere; "requiredFor" son los cursos que requieren a este.
  // Informativo por ahora (se muestra antes de inscribirse), no bloquea la
  // inscripción — igual que recomienda el propio audit para un v1.
  prerequisites CoursePrerequisite[] @relation("CourseToPrerequisite")
  requiredFor   CoursePrerequisite[] @relation("PrerequisiteToCourse")

  reviews CourseReview[]
  project CourseProject?
}

// NF40/NF41: preguntas y respuestas por lección + comentarios por
// ejercicio — mismo modelo para ambos (exactamente uno de lessonId/
// exerciseId va seteado), con un nivel de anidado vía parentId (pregunta +
// respuestas, como Udemy).
model ContentComment {
  id         String   @id @default(uuid())
  userId     String
  lessonId   String?
  exerciseId String?
  parentId   String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercise Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  parent   ContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ContentComment[] @relation("CommentReplies")

  @@index([lessonId, createdAt])
  @@index([exerciseId, createdAt])
  @@index([parentId])
}

// NF42: reportar contenido con error tipográfico/de código.
model ContentReport {
  id          String              @id @default(uuid())
  userId      String
  lessonId    String?
  exerciseId  String?
  reason      String
  description String?
  status      ContentReportStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum ContentReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// NF28: proyecto final evaluado, distinto de una lección/ejercicio suelto —
// un solo proyecto por curso, con entregas revisadas por un admin.
model CourseProject {
  id           String   @id @default(uuid())
  courseId     String   @unique
  title        String
  instructions String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course      Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions CourseProjectSubmission[]
}

model CourseProjectSubmission {
  id             String                  @id @default(uuid())
  projectId      String
  userId         String
  submissionUrl  String?
  submissionText String?
  status         ProjectSubmissionStatus @default(PENDING)
  reviewNote     String?
  submittedAt    DateTime                @default(now())
  reviewedAt     DateTime?
  reviewedById   String?

  project CourseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, status])
}

enum ProjectSubmissionStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

// HI13: reseñas y calificaciones de curso.
model CourseReview {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model CoursePrerequisite {
  id                   String @id @default(uuid())
  courseId             String
  prerequisiteCourseId String

  course             Course @relation("CourseToPrerequisite", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse Course @relation("PrerequisiteToCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
}

// HI8/NF1: secuencias curadas de cursos con un orden recomendado.
model LearningPath {
  id        String   @id @default(uuid())
  slug      String   @unique
  imageUrl  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations LearningPathTranslation[]
  courses      LearningPathCourse[]

  @@index([active, sortOrder])
}

model LearningPathTranslation {
  id             String  @id @default(uuid())
  learningPathId String
  languageId     String
  title          String
  description    String?

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  language     Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, languageId])
}

// NF6: categorías/tags de curso, filtro combinable en el catálogo.
model CourseCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  courses Course[] @relation("CourseToCourseCategory")

  @@index([sortOrder])
}

model LearningPathCourse {
  id             String @id @default(uuid())
  learningPathId String
  courseId       String
  order          Int    @default(1)

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, courseId])
  @@index([learningPathId, order])
}

model CourseTranslation {
  id             String  @id @default(uuid())
  courseId       String
  languageId     String
  title          String
  description    String?
  seoTitle       String?
  seoDescription String?

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([courseId, languageId])
}

model Lesson {
  id       String        @id @default(uuid())
  courseId String
  order    Int
  type     LessonType    @default(TEXT)
  status   ContentStatus @default(PUBLISHED)

  experience Int @default(50)
  coins      Int @default(10)

  content Json?

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  exercises   Exercise[]
  completions Completion[]

  translations LessonTranslation[]
  comments     ContentComment[]
  reports      ContentReport[]
}

model LessonTranslation {
  id          String  @id @default(uuid())
  lessonId    String
  languageId  String
  title       String
  description String?
  content     Json?

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([lessonId, languageId])
}

model Exercise {
  id       String        @id @default(uuid())
  lessonId String
  order    Int
  type     ExerciseType  @default(CODE)
  status   ContentStatus @default(PUBLISHED)

  content Json?

  codes Json?

  experience Int @default(10)
  coins      Int @default(5)

  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completions      Completion[]
  exerciseAttempts ExerciseAttempt[]

  translations ExerciseTranslation[]
  comments     ContentComment[]
  reports      ContentReport[]

  duels Duel[]
}

model ExerciseTranslation {
  id          String  @id @default(uuid())
  exerciseId  String
  languageId  String
  title       String
  description String?
  content     Json?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, languageId])
}

model Enrollment {
  id       String @id @default(uuid())
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Completion {
  id         String  @id @default(uuid())
  userId     String
  courseId   String?
  lessonId   String?
  exerciseId String?

  // DB7: cuántos intentos (correctos + fallidos) le tomó al usuario llegar a
  // este completion, el puntaje del intento que lo logró (% de tests/quiz
  // acertados) y cuánto tiempo pasó trabajando en el ejercicio. Alimentado
  // desde ExerciseAttempt en exercise.service.ts.
  attempts         Int  @default(1)
  score            Int?
  timeSpentSeconds Int?

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId, lessonId, exerciseId])
}

// Registra cada envío de respuesta (correcto o no) a un ejercicio, no solo
// el que finalmente lo completa. Completion solo guarda un hecho final por
// usuario/ejercicio (constraint único), así que sin esta tabla no hay forma
// de saber cuántos intentos fallidos hubo ni en qué ejercicios se traban más
// los estudiantes (CUR8).
model ExerciseAttempt {
  id               String   @id @default(uuid())
  userId           String
  exerciseId       String
  correct          Boolean
  score            Int?
  timeSpentSeconds Int?
  createdAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, correct])
  @@index([userId, exerciseId])
}

model MissionCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  missions Mission[]

  @@index([active, sortOrder])
}

model Mission {
  id            String            @id @default(uuid())
  categoryId    String?
  name          String
  description   String
  icon          String?
  imageUrl      String?
  cadence       MissionCadence    @default(PERMANENT)
  condition     String
  requiredValue Int               @default(1)
  active        Boolean           @default(true)
  visibility    MissionVisibility @default(VISIBLE)
  repeatable    Boolean           @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int               @default(0)
  rewards       Json?
  dependencies  Json?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  category MissionCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  progress UserMissionProgress[]

  @@index([active, visibility, cadence, sortOrder])
  @@index([startsAt, endsAt])
}

model UserMissionProgress {
  id           String                @id @default(uuid())
  userId       String
  missionId    String
  currentValue Int                   @default(0)
  targetValue  Int                   @default(1)
  status       MissionProgressStatus @default(PENDING)
  completedAt  DateTime?
  claimedAt    DateTime?
  periodKey    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, periodKey])
  @@index([userId, status, updatedAt])
  @@index([missionId, status])
}

model GamificationAchievement {
  id            String   @id @default(uuid())
  name          String
  description   String
  icon          String?
  imageUrl      String?
  condition     String
  requiredValue Int      @default(1)
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  rewards       Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unlockedBy UserGamificationAchievement[]

  @@index([visible, sortOrder])
  @@index([condition])
}

model UserGamificationAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  claimedAt     DateTime?

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement GamificationAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model RewardLedgerEntry {
  id         String                 @id @default(uuid())
  userId     String
  sourceType RewardSourceType
  sourceId   String?
  rewardType GamificationRewardType
  amount     Int?
  itemId     String?
  label      String
  message    String?
  payload    Json?
  grantedAt  DateTime               @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([userId, sourceType, grantedAt])
  @@index([rewardType, grantedAt])
}

model RewardBundle {
  id          String   @id @default(uuid())
  name        String
  description String?
  rewards     Json
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, createdAt])
}

model GamificationBadge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  rarity      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unlockedBy UserGamificationBadge[]
}

// RewardLedgerEntry.itemId es FK estricta a Item (objetos del mundo
// virtual) — nunca pudo apuntar a una insignia, por eso el catálogo de
// GamificationBadge quedaba modelado pero sin forma real de "pertenecer" a
// un usuario. Esta tabla es la que faltaba (mismo patrón que
// UserGamificationAchievement).
model UserGamificationBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge GamificationBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, unlockedAt])
}

model GamificationPet {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  rarity      String?
  active      Boolean  @default(true)
