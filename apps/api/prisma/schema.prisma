// NF23: el leaderboard general (RankingsService) se calcula en vivo sobre
// totales acumulados de siempre (User.experience/coins) — no había concepto
// de "temporada" ni reseteo periódico. Una temporada acota la ventana de
// tiempo; mientras está ACTIVE el ranking se computa en vivo sumando
// XPTransaction/CoinTransaction dentro de [startAt, ahora]. Al finalizar,
// se congela un RankingSeasonEntry por usuario (historial real, no se
// vuelve a recalcular).
model RankingSeason {
  id      String              @id @default(uuid())
  name    String
  startAt DateTime
  endAt   DateTime?
  status  RankingSeasonStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  entries RankingSeasonEntry[]

  @@index([status])
}

