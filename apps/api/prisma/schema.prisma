  active      Boolean @default(true)
  order       Int     @default(0)
  visible     Boolean @default(true)
  metadata    Json?

  // Perfil que hace que el TIPO de app cambie la simulacion de verdad, no
  // solo el nombre/icono: { growthMultiplier, retentionBase,
  // infraCostMultiplier, networkEffect, bugTolerance, channelEffectiveness }
  // — leido por codestudio-engine.service.ts en cada tick y por
  // launchCampaign al calcular usuarios ganados por canal.
  simulationProfile Json?

  blueprint CodeStudioBlueprint?
  companies CodeStudioCompany[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, visible, order])
  @@index([category])
}

model CodeStudioModule {
