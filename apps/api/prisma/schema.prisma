// Cada vez que un jugador lanza una campana real (paga baseCost, gana
// usuarios atribuidos a ese canal especifico) queda un registro aca — asi se
// puede comparar canal contra canal ("gracias a TikTok +45 usuarios, a
// Facebook +12") en vez de que marketing sea solo una barra decorativa.
model CodeStudioCampaignRun {
  id          String   @id @default(uuid())
  companyId   String
  campaignId  String
  channel     String
  cost        Int
  gainedUsers Int
  createdAt   DateTime @default(now())

  company  CodeStudioCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign CodeStudioCampaign @relation(fields: [campaignId], references: [id])

  @@index([companyId, channel])
}

