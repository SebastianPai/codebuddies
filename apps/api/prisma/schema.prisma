// Insignia junto al nombre de usuario (verificado = lo activa un admin en
// CreatorProfile.verified; creador = automático, se calcula por tener al
// menos un MarketplaceContent en PUBLISHED). Este modelo solo guarda el
// ícono opcional que el admin puede subir para reemplazar el ícono por
// defecto de cada tipo — si iconUrl es null, el cliente usa su ícono lucide
// por defecto.
enum BadgeType {
  VERIFIED
  CREATOR
}

// STATIC = una sola imagen fija (insignias básicas).
// SPRITE = tira horizontal de `frameCount` cuadros iguales, animada
// (insignias pro/premium) — mismo ancho total / frameCount = ancho de cada
// cuadro.
enum BadgeIconMode {
  STATIC
  SPRITE
}

// PINGPONG: 1,2,3,4,5,6,5,4,3,2,1,2... (ida y vuelta, Phaser "yoyo").
// LOOP: 1,2,3,4,5,6,1,2,3... (corte directo del último cuadro al primero).
enum BadgeAnimationDirection {
  PINGPONG
  LOOP
}

model BadgeConfig {
  id      String        @id @default(uuid())
  type    BadgeType     @unique
  iconUrl String?
  mode    BadgeIconMode @default(STATIC)
  // Alto en pixeles al que se renderiza la insignia (el ancho sigue la
  // proporción real del ícono/frame) — configurable porque el tamaño fijo
  // por defecto (14px) se veía "como un punto".
  size    Int           @default(16)

  frameCount Int                     @default(6)
  direction  BadgeAnimationDirection @default(PINGPONG)
  frameRate  Int                     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums separados de BadgeIconMode/BadgeAnimationDirection a propósito: son
// idénticos hoy pero pertenecen a un dominio distinto (imágenes generales del
// juego tipo logo/puerta, no insignias de perfil) y no queremos que cambiar
// uno afecte al otro.
enum ThemeAssetIconMode {
  STATIC
  SPRITE
}

enum ThemeAssetAnimationDirection {
  PINGPONG
  LOOP
}

// Un "slot" es una imagen administrable del juego (el logo, la puerta de
// Salas, etc.) — la key la referencia el código, el resto es solo para
// mostrar en el admin. Se crean por seed (ThemeAssetsService.SLOT_REGISTRY),
// no desde la UI, porque cada slot nuevo necesita código que lo consuma.
model ThemeAssetSlot {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ThemeAssetVariant[]
}

// Hasta 5 variantes por slot (límite validado en el service, no acá) — ej.
// "Default" + "Navidad 2026" + "Halloween" — de las cuales como máximo una
// tiene isActive: true a la vez. Ninguna activa = el frontend usa el
// fallback hardcodeado que ya existía antes de este sistema.
model ThemeAssetVariant {
  id         String                       @id @default(uuid())
  slotId     String
  slot       ThemeAssetSlot               @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name       String
  imageUrl   String
  mode       ThemeAssetIconMode           @default(STATIC)
  frameCount Int                          @default(6)
  direction  ThemeAssetAnimationDirection @default(PINGPONG)
  frameRate  Int                          @default(10)
  isActive   Boolean                      @default(false)
  order      Int                          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slotId, name])
  @@index([slotId])
}

