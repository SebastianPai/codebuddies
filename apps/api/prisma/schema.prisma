// Arbol de tecnologia real: cada nodo desbloqueado por una empresa queda
// registrado aca. requirements.requires (en CodeStudioTechnology) exige que
// los slugs listados ya esten en esta tabla para esa empresa antes de poder
// desbloquear el siguiente nodo de la rama — asi cada categoria forma una
// cadena de nodos, no una lista plana de compras sueltas.
model CodeStudioCompanyTechnology {
  id           String   @id @default(uuid())
  companyId    String
  technologyId String
  unlockedAt   DateTime @default(now())

  company    CodeStudioCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technology CodeStudioTechnology @relation(fields: [technologyId], references: [id])

  @@unique([companyId, technologyId])
}

