// Incidentes reales que el motor detecta por umbral (errores de trafico,
// latencia, estabilidad — mismas condiciones que ya disparaban un
// CodeStudioEventLog informativo) y que el jugador puede resolver pagando
// cash o asignando un empleado. Mientras siguen OPEN, el motor les aplica un
// castigo pasivo a rating/estabilidad en cada tick (ver
// codestudio-engine.service.ts) — ignorarlos tiene costo real, no es solo
// decorativo.
model CodeStudioBug {
  id          String                @id @default(uuid())
  companyId   String
  kind        String
  title       String
  description String
  severity    CodeStudioBugSeverity
  status      CodeStudioBugStatus   @default(OPEN)
  fixCost     Int
  createdAt   DateTime              @default(now())
  fixedAt     DateTime?

  company CodeStudioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}
