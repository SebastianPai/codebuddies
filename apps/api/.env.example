# Modo de ejecución. En producción (Heroku) debe ser exactamente
# "production": controla si la cookie access_token se marca Secure y si
# Express confía en los headers X-Forwarded-* del proxy (ver main.ts).
# Heroku NO la setea automáticamente en runtime — hay que agregarla como
# config var de la app.
NODE_ENV=development

# Prisma / PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/codebuddies_db"

# DeepL (traducciones)
DEEPL_API_KEY=

# Almacenamiento (Cloudflare R2, API S3-compatible)
# Account ID de Cloudflare — el endpoint S3 se arma como
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (ver r2.storage.ts).
R2_ACCOUNT_ID=
# Credenciales del API token de R2 (Cloudflare dashboard → R2 → Manage API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket de R2.
R2_BUCKET=
# URL pública desde la que se sirven los objetos subidos (dominio propio
# conectado al bucket, p. ej. https://assets.codebuddies.tech, o el
# subdominio r2.dev del bucket mientras no haya dominio propio). Sin barra
# final — r2.storage.ts arma las URLs como `${R2_PUBLIC_URL}/${path}`.
R2_PUBLIC_URL=

# JWT (obligatorio: la app falla al arrancar si falta)
JWT_SECRET=

# Orígenes permitidos por CORS (HTTP + WebSocket), separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Email transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM="CodeBuddies <onboarding@resend.dev>"

# Redis (opcional). Dos usos independientes:
# - Socket.IO: si se configura REDIS_URL, usa Redis pub/sub para escalar a
#   más de un proceso/instancia del backend. Sin esto, el server funciona
#   igual pero limitado a un solo proceso (adapter en memoria).
# - Cache de catálogo/rankings/dashboard admin (HI12): CacheService intenta
#   conectar a REDIS_URL (o redis://localhost:6379 si no está seteada) y se
#   degrada solo a "sin cache" si no puede — no requiere esta variable para
#   funcionar en dev local con `docker compose up redis`.
REDIS_URL=

# Paddle (pagos de certificados + suscripción premium). Sin PADDLE_API_KEY
# configurada, el sistema sigue usando los providers mock automáticamente
# (ver payments.module.ts / subscriptions.module.ts) — no hace falta tocar
# código cuando se carguen las credenciales reales, alcanza con completar
# estas variables y reiniciar la API.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# "sandbox" o "production"
PADDLE_ENVIRONMENT=sandbox
# Price id recurrente (mensual) precreado en el dashboard de Paddle para el
# plan Premium.
PADDLE_PREMIUM_PRICE_ID=
# Product id precreado en el dashboard de Paddle para "Certificado
# CodeBuddies" — el precio se arma ad-hoc por orden (ver
# paddle-payment.provider.ts), pero Paddle igual requiere un producto
# existente al que asociarlo.
PADDLE_CERTIFICATE_PRODUCT_ID=
# Precio plano del certificado pago en USD (coincide con /pricing).
CERTIFICATE_PRICE_USD=4.99

# Base del link público de verificación de certificados (certificates.service.ts).
# Opcional — sin ella cae a "https://codebuddies.app/certificates/verify".
CERTIFICATE_VERIFICATION_BASE_URL=https://codebuddies.tech/certificates/verify
