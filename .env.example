# Prisma / PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/codebuddies_db"

# DeepL (traducciones)
DEEPL_API_KEY=

# Almacenamiento (DigitalOcean Spaces)
STORAGE_DRIVER=spaces
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
CDN_URL=

# JWT (obligatorio: la app falla al arrancar si falta)
JWT_SECRET=

# Orígenes permitidos por CORS (HTTP + WebSocket), separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Email transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM="CodeBuddies <onboarding@resend.dev>"
