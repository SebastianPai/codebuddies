generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LessonType {
  TEXT
  CODE
  QUIZ
  LIVE
}

enum ExerciseType {
  CODE
  LIVE
  QUIZ
}

enum RankingType {
  WEEKLY
  MONTHLY
  GLOBAL
}

enum ItemType {
  BODY
  HEAD
  HAIR
  EYES
  SHIRT
  LEGS
  SHOES
  LEFT_ARM
  RIGHT_ARM
  ACCESSORY_HEAD
  ACCESSORY_FACE
  ACCESSORY_BACK
  ACCESSORY_LEFT
  ACCESSORY_RIGHT
  ROOM_ITEM
}

enum AvatarSlotType {
  BODY
  HEAD
  HAIR
  EYES
  SHIRT
  LEGS
  SHOES
  LEFT_ARM
  RIGHT_ARM
  ACCESSORY_HEAD
  ACCESSORY_FACE
  ACCESSORY_BACK
  ACCESSORY_LEFT
  ACCESSORY_RIGHT
}

enum ItemAccessType {
  FREE
  PREMIUM
  EVENT
  VIP
}

enum Direction {
  NORTH
  NORTH_EAST
  EAST
  SOUTH_EAST
  SOUTH
  SOUTH_WEST
  WEST
  NORTH_WEST
}

enum ActivityType {
  COMPLETED_LESSON
  COMPLETED_EXERCISE
  STARTED_COURSE
  EARNED_ACHIEVEMENT
  CREATED_PROJECT
  CREATED_POST
}

enum ReactionType {
  LIKE
  FIRE
  CLAP
  ROCKET
}

enum AnimationType {
  IDLE
  WALK
  RUN
  SIT
  WAVE
  DANCE
  ATTACK
}

enum Currency {
  COINS
  USD
  COP
  CLP
  EUR
}

enum SubscriptionType {
  FREE
  PREMIUM
  VIP
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  password     String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  avatarBorder String?
  location     String?
  institution  String?

  experience   Int      @default(0)
  coins        Int      @default(0)
  level        Int      @default(1)

  energy       Int      @default(5)
  streak       Int      @default(0)

  energyUpdatedAt DateTime @default(now())
  adsWatchedToday Int @default(0)
  adsResetAt      DateTime @default(now())

  preferredLanguageId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]
  completions  Completion[]

  userPowers   UserPower[]
  achievements UserAchievement[]
  rankings     Ranking[]

  subscription Subscription[]

  preferredLanguage Language? @relation(fields: [preferredLanguageId], references: [id])

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  posts Post[]
  projects Project[]

  activities Activity[]

  coinTransactions CoinTransaction[]
  xpTransactions XPTransaction[]

  // Relaciones bidireccionales añadidas
  postComments            PostComment[]
  postLikes               PostLike[]
  projectLikes            ProjectLike[]
  challengesAsChallenger  FriendChallenge[] @relation("ChallengeChallenger")
  challengesAsOpponent    FriendChallenge[] @relation("ChallengeOpponent")

  duelsAsPlayer1 Duel[] @relation("DuelPlayer1")
  duelsAsPlayer2 Duel[] @relation("DuelPlayer2")

  // juego
  avatar Avatar?
  items UserItem[]
  rooms Room[]
}

model Avatar {
  id     String @id @default(uuid())
  userId String @unique

  skinColor Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  slots  AvatarSlot[]
}

model Item {
  id        String @id @default(uuid())
  type      ItemType
  imageUrl  String?

  layer     Int @default(0)
  rarity    Int @default(0)

  colorable Boolean @default(false)

  accessType ItemAccessType @default(FREE) // 🔥 CLAVE

  createdAt DateTime @default(now())

  users UserItem[]
  prices ItemPrice[]
  translations ItemTranslation[]

  roomItems RoomItem[]

  avatarSlots   AvatarSlot[]

  sprites       ItemSprite[]
}

model ItemTranslation {
  id         String @id @default(uuid())
  itemId     String
  languageId String

  name        String
  description String?

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([itemId, languageId])
}

model ItemPrice {
  id       String @id @default(uuid())
  itemId   String

  currency Currency
  amount   Int

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, currency])
}

model UserItem {
  id      String @id @default(uuid())
  userId  String
  itemId  String
  amount  Int @default(1)

  equipped Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model AvatarSlot {
  id String @id @default(uuid())

  avatarId String
  slot AvatarSlotType

  itemId String?

  color Int?

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([avatarId, slot])
}

model ItemSprite {
  id        String @id @default(uuid())
  itemId    String

  animationId String
  animation   Animation @relation(fields: [animationId], references: [id])

  direction Direction

  imageUrl String

  frameWidth Int
  frameHeight Int
  framesCount Int
  row         Int @default(0)

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, animationId, direction])
}

model Animation {
  id      String @id @default(uuid())

  name    String // "Walk Ninja", "Dance HipHop"
  type    AnimationType
  variant String // 🔥 conecta con ItemSprite.variant

  loop  Boolean @default(true)
  speed Int     @default(100)

  createdAt DateTime @default(now())

  sprites ItemSprite[]

  @@unique([type, variant])
  
}

model Room {
  id        String @id @default(uuid())
  ownerId   String
  name      String
  isPublic  Boolean @default(false)

  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items RoomItem[]
}

model RoomItem {
  id      String @id @default(uuid())
  roomId  String
  itemId  String

  x Int
  y Int

  zIndex Int @default(0)

  rotation Int @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model PublicRoom {
  id   String @id @default(uuid())
  name String
  map  String
}

model Duel {
  id        String @id @default(uuid())
  player1Id String
  player2Id String

  exerciseId String

  winnerId String?

  createdAt DateTime @default(now())

  player1 User @relation("DuelPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 User @relation("DuelPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Module {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  translations ModuleTranslation[]
  courses      Course[]
}

model ModuleTranslation {
  id          String @id @default(uuid())
  moduleId    String
  languageId  String
  title       String
  description String?

  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([moduleId, languageId])
}

model Course {
  id         String     @id @default(uuid())
  moduleId   String?
  imageUrl   String?
  difficulty Difficulty @default(EASY)
  freeLimit  Int        @default(5)

  createdAt  DateTime   @default(now())

  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  lessons      Lesson[]
  enrollments  Enrollment[]
  achievements Achievement[]
  completions  Completion[]

  translations CourseTranslation[]

  // Relación bidireccional añadida
  friendChallenges FriendChallenge[]
}

model CourseTranslation {
  id             String @id @default(uuid())
  courseId       String
  languageId     String
  title          String
  description    String?
  seoTitle       String?
  seoDescription String?

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([courseId, languageId])
}

model Lesson {
  id         String     @id @default(uuid())
  courseId   String
  order      Int
  type       LessonType @default(TEXT)

  experience Int @default(50)
  coins      Int @default(10)

  content Json?

  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  exercises   Exercise[]
  completions Completion[]

  translations LessonTranslation[]
}

model LessonTranslation {
  id          String @id @default(uuid())
  lessonId    String
  languageId  String
  title       String
  description String?
  content     Json?

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([lessonId, languageId])
}

model Exercise {
  id       String @id @default(uuid())
  lessonId String
  order    Int
  type     ExerciseType @default(CODE)

  content Json?

  codes Json?

  experience Int @default(10)
  coins      Int @default(5)

  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completions Completion[]

  translations ExerciseTranslation[]

  duels Duel[]
}

model ExerciseTranslation {
  id         String @id @default(uuid())
  exerciseId String
  languageId String
  title      String
  description String?
  content    Json?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, languageId])
}

model Enrollment {
  id       String @id @default(uuid())
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Completion {
  id         String @id @default(uuid())
  userId     String
  courseId   String?
  lessonId   String?
  exerciseId String?

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson   Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId, lessonId, exerciseId])
}

model Achievement {
  id          String @id @default(uuid())
  courseId    String
  rewardXP    Int @default(0)
  rewardCoins Int @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userAchievements UserAchievement[]
  translations AchievementTranslation[]
}

model AchievementTranslation {
  id            String @id @default(uuid())
  achievementId String
  languageId    String
  title         String
  description   String?

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([achievementId, languageId])
}

model UserAchievement {
  id            String @id @default(uuid())
  userId        String
  achievementId String

  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Power {
  id         String @id @default(uuid())
  priceCoins Int @default(100)

  userPowers UserPower[]

  translations PowerTranslation[]
}

model PowerTranslation {
  id         String @id @default(uuid())
  powerId    String
  languageId String
  name       String
  description String?

  power    Power    @relation(fields: [powerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([powerId, languageId])
}

model UserPower {
  id      String @id @default(uuid())
  userId  String
  powerId String

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  power Power @relation(fields: [powerId], references: [id], onDelete: Cascade)

  @@unique([userId, powerId])
}

model Ranking {
  id     String @id @default(uuid())
  userId String

  score  Int @default(0)

  type   RankingType @default(GLOBAL)
  period String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String @id @default(uuid())
  userId    String

  type      SubscriptionType @default(FREE) // 🔥 CLAVE
  active    Boolean @default(true)
  
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Language {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  direction String @default("ltr")

  createdAt DateTime @default(now())

  users User[]

  moduleTranslations      ModuleTranslation[]
  courseTranslations      CourseTranslation[]
  lessonTranslations      LessonTranslation[]
  exerciseTranslations    ExerciseTranslation[]
  achievementTranslations AchievementTranslation[]
  powerTranslations       PowerTranslation[]

  // Relaciones bidireccionales añadidas (las que faltaban)
  postTranslations        PostTranslation[]
  commentTranslations     CommentTranslation[]
  projectTranslations     ProjectTranslation[]

  itemTranslations ItemTranslation[]
}

model Post {
  id        String @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments PostComment[]
  likes    PostLike[]

  translations PostTranslation[]
}

model PostTranslation {
  id         String @id @default(uuid())
  postId     String
  languageId String
  content    String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([postId, languageId])
}

model PostComment {
  id        String @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  translations CommentTranslation[]
}

model CommentTranslation {
  id          String @id @default(uuid())
  commentId   String
  languageId  String
  content     String

  comment  PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  language Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([commentId, languageId])
}

model PostLike {
  id     String @id @default(uuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Project {
  id        String @id @default(uuid())
  userId    String
  code      Json
  language  String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes ProjectLike[]

  tags ProjectTag[]

  translations ProjectTranslation[]
}

model ProjectTranslation {
  id          String @id @default(uuid())
  projectId   String
  languageId  String
  title       String
  description String?

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([projectId, languageId])
}

model ProjectLike {
  id        String @id @default(uuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  projects ProjectTag[]
}

model ProjectTag {
  id        String @id @default(uuid())
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
}

model Activity {
  id        String @id @default(uuid())
  userId    String
  type      ActivityType
  metadata  Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendChallenge {
  id           String @id @default(uuid())
  challengerId String
  opponentId   String
  courseId     String?

  completed Boolean @default(false)

  createdAt DateTime @default(now())

  challenger User @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model CoinTransaction {
  id        String @id @default(uuid())
  userId    String
  amount    Int
  reason    String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ColorPalette {
  id String @id @default(uuid())

  type String

  value String
}

model XPTransaction {
  id        String @id @default(uuid())
  userId    String
  amount    Int
  reason    String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}