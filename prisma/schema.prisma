model CodeStudioCompany {
  id        String @id @default(uuid())
  userId    String
  appTypeId String

  name         String
  status       CodeStudioCompanyStatus @default(IDEA)
  level        Int                     @default(1)
  cash         Int                     @default(5000)
  reputation   Float                   @default(5)
  innovation   Float                   @default(1)
  valuation    Int                     @default(0)
  activeUsers  Int                     @default(0)
  totalUsers   Int                     @default(0)
  revenue      Int                     @default(0)
  expenses     Int                     @default(0)
  satisfaction Float                   @default(75)
  bugs         Float                   @default(0)
  latency      Float                   @default(120)
  stability    Float                   @default(99)
  rating       Float                   @default(4)
  tickCount    Int                     @default(0)

  blueprintSnapshot Json?
  stats             Json?
  metadata          Json?
  lastSimulatedAt   DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  appType CodeStudioAppType @relation(fields: [appTypeId], references: [id])

  modules        CodeStudioCompanyModule[]
  employees      CodeStudioEmployee[]
  infrastructure CodeStudioInfrastructure[]
  development    CodeStudioDevelopmentTask[]
  snapshots      CodeStudioAnalyticsSnapshot[]
  events         CodeStudioEventLog[]

  @@index([userId, updatedAt])
  @@index([valuation])
  @@index([activeUsers])
}

model CodeStudioCompanyModule {
  id        String @id @default(uuid())
  companyId String
  moduleId  String

  level       Int      @default(1)
  quality     Float    @default(1)
  installedAt DateTime @default(now())
