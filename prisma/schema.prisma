model CodeStudioBlueprint {
  id        String @id @default(uuid())
  appTypeId String @unique
  name      String
  version   Int    @default(1)

  initialStats          Json?
  requirements          Json?
  technologies          Json?
  suggestedCosts        Json?
  suggestedTimes        Json?
  compatibleEvents      Json?
  recommendedEmployees  Json?
  initialInfrastructure Json?
  metadata              Json?

  appType CodeStudioAppType           @relation(fields: [appTypeId], references: [id], onDelete: Cascade)
  modules CodeStudioBlueprintModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CodeStudioBlueprintModule {
  id          String  @id @default(uuid())
  blueprintId String
  moduleId    String
  parentIds   Json?
  position    Json?
  required    Boolean @default(true)
  order       Int     @default(0)
  config      Json?

  blueprint CodeStudioBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  module    CodeStudioModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, moduleId])
  @@index([blueprintId, order])
