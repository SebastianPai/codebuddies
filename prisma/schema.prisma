  infrastructureTypeId String

  level     Int   @default(1)
  capacity  Int   @default(1000)
  latency   Float @default(120)
  stability Float @default(99)
  cost      Int   @default(100)
  metadata  Json?

  company            CodeStudioCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  infrastructureType CodeStudioInfrastructureType @relation(fields: [infrastructureTypeId], references: [id])

  @@unique([companyId, infrastructureTypeId])
}

model CodeStudioAnalyticsSnapshot {
  id        String @id @default(uuid())
  companyId String

  activeUsers Int
  newUsers    Int
  lostUsers   Int
  retention   Float
  conversion  Float
  errors      Float
  latency     Float
  rating      Float
  revenue     Int
  expenses    Int
  metadata    Json?
  createdAt   DateTime @default(now())

  company CodeStudioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model CodeStudioEventLog {
  id          String   @id @default(uuid())
  companyId   String
  templateId  String?
  title       String
  description String?
  effects     Json?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  company  CodeStudioCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template CodeStudioEventTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}
