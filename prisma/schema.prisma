  company CodeStudioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  CodeStudioModule  @relation(fields: [moduleId], references: [id])

  @@unique([companyId, moduleId])
  @@index([companyId])
}

model CodeStudioDevelopmentTask {
  id        String @id @default(uuid())
  companyId String
  moduleId  String

  status            CodeStudioDevelopmentStatus @default(QUEUED)
  progress          Float                       @default(0)
  requiredSeconds   Int
  spentSeconds      Int                         @default(0)
  assignedEmployees Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  company CodeStudioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  CodeStudioModule  @relation(fields: [moduleId], references: [id])

  @@index([companyId, status])
}

model CodeStudioEmployee {
  id             String @id @default(uuid())
  companyId      String
  employeeTypeId String

  name         String
  avatar       String?
  age          Int
  experience   Int      @default(1)
  productivity Float    @default(1)
  creativity   Float    @default(1)
  motivation   Float    @default(80)
  stress       Float    @default(5)
  salary       Int
  speed        Float    @default(1)
  quality      Float    @default(1)
  level        Int      @default(1)
  hiredAt      DateTime @default(now())
  metadata     Json?

  company      CodeStudioCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeType CodeStudioEmployeeType @relation(fields: [employeeTypeId], references: [id])

  @@index([companyId])
}

model CodeStudioInfrastructure {
