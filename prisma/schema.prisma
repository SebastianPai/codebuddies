  PREMIUM_ACTIVATED
  ACHIEVEMENT_UNLOCKED
  MISSION_AVAILABLE
  MISSION_COMPLETED
  MISSION_REWARD_CLAIMED
  REWARD_GRANTED
  LEVEL_UPDATED
  EVENT_CREATED
  SEASON_STARTED
  SEASON_ENDED
  REFERRAL_PENDING
  REFERRAL_VALIDATED
  REFERRAL_REWARD_UNLOCKED
  REFERRAL_RANKING_UPDATED
  REFERRAL_FRAUD_FLAGGED
  ROOM_JOIN_REQUEST
  ROOM_JOIN_APPROVED
