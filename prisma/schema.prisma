  rewards   ReferralReward[]
  stats     ReferralSeasonStat[]

  @@index([status, startsAt, endsAt])
}

model Referral {
  id                 String         @id @default(uuid())
  referrerUserId     String
  referredUserId     String         @unique
  seasonId           String?
  referralCodeUsed   String
  source             String?
  status             ReferralStatus @default(PENDING)
  validationSnapshot Json?
  fraudSignals       Json?
  riskScore          Int            @default(0)
  evaluatedAt        DateTime?
  validatedAt        DateTime?
  rejectedAt         DateTime?
  revokedAt          DateTime?
  fraudAt            DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  referrer User            @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User            @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  season   ReferralSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  rewardGrants ReferralRewardGrant[]
  fraudLogs    ReferralFraudLog[]

  @@index([referrerUserId, status, createdAt])
  @@index([referredUserId, status])
  @@index([seasonId, status])
}

model ReferralReward {
  id          String              @id @default(uuid())
  seasonId    String?
  name        String
  description String?
  scope       ReferralRewardScope @default(MILESTONE)
  rewardType  ReferralRewardType
  threshold   Int?
  rankFrom    Int?
  rankTo      Int?
  amount      Int?
  itemId      String?
  payload     Json?
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  item   Item?                 @relation(fields: [itemId], references: [id], onDelete: SetNull)
  season ReferralSeason?       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  grants ReferralRewardGrant[]

  @@index([scope, active, sortOrder])
  @@index([seasonId, active])
}

model ReferralRewardGrant {
  id              String              @id @default(uuid())
  userId          String
  referralId      String?
  rewardId        String?
  itemId          String?
  rewardType      ReferralRewardType
  scope           ReferralRewardScope
  status          ReferralGrantStatus @default(GRANTED)
  amount          Int?
  payloadSnapshot Json?
  reason          String?
  grantedAt       DateTime            @default(now())
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referral Referral?       @relation(fields: [referralId], references: [id], onDelete: SetNull)
  reward   ReferralReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  item     Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([userId, rewardId, referralId])
  @@index([userId, status, grantedAt])
  @@index([rewardId, userId, status])
  @@index([referralId, status])
}

model ReferralSeasonStat {
  id                 String    @id @default(uuid())
  seasonId           String
  userId             String
  validatedReferrals Int       @default(0)
  pendingReferrals   Int       @default(0)
  fraudReferrals     Int       @default(0)
  totalRewards       Int       @default(0)
  currentRank        Int?
  finalRank          Int?
  rewardGrantedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  season ReferralSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, currentRank])
  @@index([seasonId, validatedReferrals])
}

model ReferralFraudLog {
  id          String    @id @default(uuid())
  referralId  String
  userId      String?
  reasonCode  String
  notes       String?
  evidence    Json?
  riskScore   Int?
  actionTaken String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([referralId, createdAt])
  @@index([userId, createdAt])
  @@index([reasonCode, createdAt])
}

model MarketplaceSettings {
  id String @id @default("default")

  requireMinLevel      Boolean @default(true)
  minLevel             Int     @default(10)
  requireAccountAge    Boolean @default(true)
  minAccountAgeDays    Int     @default(15)
  requireEmailVerified Boolean @default(true)

  publicationFeeCoins Int @default(50)
  minPriceCoins       Int @default(100)
  maxPriceCoins       Int @default(10000)
  commissionRate      Int @default(20)

  maxPendingItems        Int @default(5)
  maxPublishedItems      Int @default(100)
  maxSubmissionsPerDay   Int @default(3)
  maxSubmissionsPerWeek  Int @default(10)
  rejectionStrikeLimit   Int @default(3)
  suspensionDaysOnStrike Int @default(7)

  metadata  Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CreatorProfile {
  id     String @id @default(uuid())
  userId String @unique

  displayName String?
  bio         String?
  avatarUrl   String?

  status         CreatorStatus   @default(ACTIVE)
  level          CreatorLevelKey @default(BRONZE)
  verified       Boolean         @default(false)
  featured       Boolean         @default(false)
  joinedAt       DateTime        @default(now())
  suspendedUntil DateTime?

  totalSales      Int @default(0)
  totalCoinsGross Int @default(0)
  followersCount  Int @default(0)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet         CreatorWallet?
  applications   CreatorApplication[]
  contents       MarketplaceContent[]
  purchases      MarketplacePurchase[]      @relation("MarketplaceCreatorSales")
  walletMoves    CreatorWalletMovement[]
  reviewComments MarketplaceReviewComment[]

  @@index([status])
  @@index([featured])
}

// Insignia junto al nombre de usuario (verificado = lo activa un admin en
// CreatorProfile.verified; creador = automático, se calcula por tener al
// menos un MarketplaceContent en PUBLISHED). Este modelo solo guarda el
// ícono opcional que el admin puede subir para reemplazar el ícono por
// defecto de cada tipo — si iconUrl es null, el cliente usa su ícono lucide
// por defecto.
enum BadgeType {
  VERIFIED
  CREATOR
}

model BadgeConfig {
  id      String    @id @default(uuid())
  type    BadgeType @unique
  iconUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreatorWallet {
  id        String @id @default(uuid())
  creatorId String @unique

  availableBalance Int @default(0)
  historicalTotal  Int @default(0)
  totalWithdrawn   Int @default(0)
  totalSales       Int @default(0)
  totalCommissions Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   CreatorProfile          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  movements CreatorWalletMovement[]
}

model CreatorWalletMovement {
  id        String  @id @default(uuid())
  creatorId String
  walletId  String?
  userId    String?

  type         MarketplaceWalletMovementType
  amount       Int
  balanceAfter Int?
  description  String?

  contentId  String?
  purchaseId String?
  metadata   Json?

  createdAt DateTime @default(now())

  creator  CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  wallet   CreatorWallet?       @relation(fields: [walletId], references: [id], onDelete: SetNull)
  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  content  MarketplaceContent?  @relation(fields: [contentId], references: [id], onDelete: SetNull)
  purchase MarketplacePurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([type])
}

model CreatorApplication {
  id        String  @id @default(uuid())
  userId    String
  creatorId String?

  status              CreatorApplicationStatus @default(PENDING)
  message             String?
  adminMessage        String?
  reviewedAt          DateTime?
  requestedInfo       Json?
  eligibilitySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

model MarketplaceContent {
  id        String @id @default(uuid())
  creatorId String

  type   MarketplaceContentType   @default(WORLD_ITEM)
  status MarketplaceContentStatus @default(DRAFT)

  title       String
  description String?
  category    String?
  tags        String[] @default([])

  spriteUrl  String?
  previewUrl String?
  priceCoins Int

  payload            Json
  validationSnapshot Json?
  metadata           Json?

  publishedItemId String?
  publishedAt     DateTime?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  retiredAt       DateTime?

  featured       Boolean @default(false)
  views          Int     @default(0)
  favoritesCount Int     @default(0)
  downloadsCount Int     @default(0)
  salesCount     Int     @default(0)
  ratingAverage  Float   @default(0)
  ratingCount    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator       CreatorProfile              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  publishedItem Item?                       @relation("PublishedMarketplaceItem", fields: [publishedItemId], references: [id], onDelete: SetNull)
  versions      MarketplaceContentVersion[]
  reviews       MarketplaceReviewComment[]
  purchases     MarketplacePurchase[]
  favorites     MarketplaceFavorite[]
  ratings       MarketplaceRating[]
  reports       MarketplaceReport[]
  walletMoves   CreatorWalletMovement[]

  @@index([status, createdAt])
  @@index([type, status])
  @@index([creatorId, status])
  @@index([featured])
}

model MarketplaceContentVersion {
  id        String @id @default(uuid())
  contentId String
  version   Int

  title            String
  description      String?
  priceCoins       Int
  payload          Json
  changeNote       String?
  statusAtCreation MarketplaceContentStatus

  createdAt DateTime @default(now())

  content MarketplaceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([contentId, createdAt])
}

model MarketplaceReviewComment {
  id        String  @id @default(uuid())
  contentId String
  creatorId String?
  adminId   String?

  message          String
  status           MarketplaceContentStatus?
  visibleToCreator Boolean                   @default(true)

  createdAt DateTime @default(now())

  content MarketplaceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  creator CreatorProfile?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  admin   User?              @relation("MarketplaceReviewAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([contentId, createdAt])
}

model MarketplacePurchase {
  id        String  @id @default(uuid())
  buyerId   String
  creatorId String
  contentId String
  itemId    String?

  priceCoins      Int
  creatorEarnings Int
  platformFee     Int
  useCount        Int       @default(0)
  usedAt          DateTime?
  placedAt        DateTime?
  equippedAt      DateTime?

  createdAt DateTime @default(now())

  buyer     User                    @relation("MarketplaceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  creator   CreatorProfile          @relation("MarketplaceCreatorSales", fields: [creatorId], references: [id], onDelete: Cascade)
  content   MarketplaceContent      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  movements CreatorWalletMovement[]

  @@unique([buyerId, contentId])
  @@index([creatorId, createdAt])
  @@index([contentId])
}

model MarketplaceFavorite {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content MarketplaceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
}

model MarketplaceRating {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content MarketplaceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
}

model MarketplaceReport {
  id        String @id @default(uuid())
  userId    String
  contentId String

  reason    MarketplaceReportReason
  status    MarketplaceReportStatus @default(OPEN)
  message   String?
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content MarketplaceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([contentId])
}

model CodeStudioAppType {
